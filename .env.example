# ===========================================================================
# Laya — ตัวอย่างไฟล์ตั้งค่า
#
#   cp .env.example .env
#
# แล้วแก้ค่าใน .env (ไฟล์ .env อยู่ใน .gitignore ไม่หลุดขึ้น git)
# ทุกค่าในนี้เป็นค่าเริ่มต้นที่ใช้ได้ทันทีบน CPU — แก้เฉพาะที่ต้องการ
#
# ห้ามใส่ค่า secret จริงลงในไฟล์ .env.example นี้ (ไฟล์นี้ถูก commit)
#
# คู่มือ: readme_th.md | endpoint_th.md | docs/docker.md | docs/http-api.md
# ===========================================================================


# ---------------------------------------------------------------------------
# BUILD — มีผลตอน `docker compose build` เท่านั้น
#
# สองตัวนี้เป็น build arg ไม่ใช่ runtime: สลับ CPU <-> CUDA ด้วย `-e` ไม่ได้
# ต้อง rebuild ใหม่ทุกครั้งที่เปลี่ยน
# ---------------------------------------------------------------------------

# index ของ PyTorch wheel: cpu | cu128 (NVIDIA) | cu130 (DGX Spark)
LAYA_TORCH_INDEX=cpu

# เวอร์ชัน PyTorch ที่ pin ไว้ — build จะ fail ถ้า wheel ไม่ตรงกับ index ข้างบน
LAYA_TORCH_VERSION=2.14.0


# ---------------------------------------------------------------------------
# DEVICE และความเร็ว
# ---------------------------------------------------------------------------

# cpu | cuda  (ไม่มี mps — Apple MPS ใช้ใน container ไม่ได้)
LAYA_DEVICE=cpu

# จำนวน thread CPU — ห้ามตั้งเกิน physical core
# ตั้งเกินจะ "ช้าลง" อย่างเห็นได้ชัด ไม่ใช่เร็วขึ้น (เครื่อง 12 core ตั้ง 8 กำลังดี)
OMP_NUM_THREADS=4

# autocast dtype: ว่างไว้ = ใช้ amp_dtype ของ checkpoint เอง (ค่าที่แนะนำ)
# LAYA_CUDA_AMP รับ fp16 | bf16 — ไม่ใช่เรื่องความสวยงาม: bf16 ทำให้ argmax
# เปลี่ยน 3 ใน 864 เคสบน parity set ขณะที่ fp16 ไม่เปลี่ยนเลย (ดู README)
LAYA_CUDA_AMP=
# LAYA_CPU_AMP รับ bf16 เท่านั้น ค่าอื่นจะเป็น fp32
LAYA_CPU_AMP=


# ---------------------------------------------------------------------------
# เลือก CHECKPOINT
# ---------------------------------------------------------------------------

# auto | english | multilingual | typed-decisions
# auto = router ตรวจ script และภาษาแล้วเลือกให้เอง (ข้อความไทย -> multilingual)
LAYA_MODEL=auto

# path ของ checkpoint ที่ fine-tune เอง (ภายใน container)
# ใช้ตัวนี้ต้องตั้ง LAYA_MODEL=auto — ตั้งพร้อมกันทั้งสองตัวไม่ได้
# ไดเรกทอรีต้องเขียนได้โดย UID 10001 (สำหรับอัปเดต tokenizer compatibility)
# ต้อง mount เข้ามาด้วย ดู compose.example.yml
LAYA_MODEL_PATH=

# Hub commit / branch / tag ที่จะใช้ดาวน์โหลดทุก checkpoint
# ใส่ `reviewed` เพื่อใช้ SHA ที่ review แล้วใน laya/revisions.py
LAYA_REVISION=


# ---------------------------------------------------------------------------
# โหมด ONE-SHOT — `docker compose run --rm laya`
# ---------------------------------------------------------------------------

# path ไฟล์ JSON คำขอ (ภายใน container)
LAYA_REQUEST_FILE=/opt/laya/examples/request.json


# ---------------------------------------------------------------------------
# HTTP SERVER — `docker compose -f compose.yaml -f compose.http.yaml up`
# ---------------------------------------------------------------------------

# host ที่ผูก port ไว้ฝั่งเครื่องเรา
#
# ค่าเริ่มต้น 127.0.0.1 = เข้าถึงได้แค่จากเครื่องนี้ ตั้งใจให้ปลอดภัยโดยปริยาย
# เพราะ API ไม่มี auth เลยจนกว่าจะตั้ง LAYA_API_KEY
#
# ถ้าจะเปิดให้เครื่องอื่นเรียก (0.0.0.0): ตั้ง LAYA_API_KEY ก่อน และอ่านหัวข้อ
# "ข้อควรระวังด้านความปลอดภัย" ใน endpoint_th.md — /docs /redoc /openapi.json
# ตอบ 200 โดยไม่ต้องใส่ key แม้ตั้ง LAYA_API_KEY แล้ว
LAYA_BIND_ADDRESS=127.0.0.1

# port (ใช้ทั้งใน container และที่ publish ออกมา จึงไม่มีทางไม่ตรงกัน)
LAYA_PORT=8000
# bind address ภายใน container — ปกติไม่ต้องแก้
LAYA_HOST=0.0.0.0

# 0 = server พร้อมทันที แต่คำขอแรกของแต่ละ checkpoint ต้องรอโหลด model เอง
# 1 = โหลดล่วงหน้าตอน start — บูตแรกจะดึง checkpoint "ทั้งตระกูล"
LAYA_PRELOAD=0

# จำกัดว่าจะ preload ตัวไหน (คั่นด้วย comma) ว่างไว้ = ทั้งหมด
# ใช้คู่กับ LAYA_PRELOAD=1 เช่น: english,multilingual
LAYA_MODELS=

# จำนวน checkpoint ที่อยู่ใน memory พร้อมกัน — ว่างไว้ = ค่าของ Router เอง (2)
# ตั้ง 3 ถ้าเปิด LAYA_AUTO_TASK ไม่งั้นจะ reload ทุกครั้งที่สลับ checkpoint
LAYA_MAX_LOADED=

# route ไป typed-decisions checkpoint อัตโนมัติ
LAYA_AUTO_TASK=0

# thread ของ torch ฝั่ง server — ว่างไว้ = ตามค่า OMP_NUM_THREADS
LAYA_THREADS=

# คำขอที่รับพร้อมกันได้ เกินกว่านี้ตอบ 503 + Retry-After ทันที (ไม่ต่อคิว)
LAYA_MAX_CONCURRENT=16

# critical | error | warning | info | debug
LAYA_LOG_LEVEL=info


# ---------------------------------------------------------------------------
# AUTH — เฉพาะ laya-serve
#
# ถ้าไม่ตั้ง: ใครก็ยิง /v1/systemone ได้
# ถ้าตั้ง: ต้องส่ง header `Authorization: Bearer <key>` ไม่งั้นได้ 401
#
# ต้อง recreate container หลังเปลี่ยนค่า — แก้ .env เฉย ๆ ไม่มีผลกับ
# container ที่รันอยู่:
#   docker compose -f compose.yaml -f compose.http.yaml up -d --wait laya-serve
#
# /health เปิดไว้เสมอไม่ต้องใส่ key (healthcheck ของ container เรียกเอง)
# ---------------------------------------------------------------------------

# ใส่คีย์ของคุณใน .env — อย่าใส่ค่าจริงในไฟล์ .env.example นี้
LAYA_API_KEY=

# ทางที่ปลอดภัยกว่าสำหรับ production: อ่านคีย์จากไฟล์ที่ mount เข้ามา
# entrypoint อ่านไฟล์ตอน start แล้วลบตัวแปร _FILE ทิ้ง คีย์จึงไม่ค้างอยู่ใน
# environment ของ container (ตรวจได้ด้วย docker inspect)
# ไฟล์ต้องอ่านได้โดย UID 10001 และต้อง mount เข้ามา ดู compose.http.yaml
# LAYA_API_KEY_FILE=/run/secrets/laya_api_key


# ---------------------------------------------------------------------------
# HUGGING FACE
#
# checkpoint ที่ Laya ใช้เป็น public — ไม่ต้องมี token
# ---------------------------------------------------------------------------

# ตั้งเมื่อใช้ checkpoint ส่วนตัว หรือเจอ rate limit ของ Hub
# อย่าใส่ค่าจริงในไฟล์นี้ — ใส่ใน .env หรือใช้ HF_TOKEN_FILE
HF_TOKEN=

# อ่าน token จากไฟล์ที่ mount เข้ามา (มีลำดับความสำคัญสูงกว่า HF_TOKEN)
# ไฟล์ต้องอ่านได้โดย UID 10001
# HF_TOKEN_FILE=/run/secrets/hf_token

# 1 = ใช้แต่ checkpoint ที่ cache ไว้แล้ว ไม่ต่อเน็ต
HF_HUB_OFFLINE=0


# ---------------------------------------------------------------------------
# CACHE และ GPU — Compose เท่านั้น
# ---------------------------------------------------------------------------

# ชื่อ volume ที่เก็บ weights — ว่างไว้ = <ชื่อโปรเจกต์>_model-cache
# ตั้งชื่อเองถ้าอยากให้หลายโปรเจกต์ใช้ cache ร่วมกัน (จะได้ไม่ดาวน์โหลดซ้ำ)
LAYA_CACHE_VOLUME=

# index หรือ UUID ของ GPU บน host — ใน container จะเห็นเป็น device 0
# ใช้เมื่อรันด้วย -f compose.cuda.yaml หรือ -f compose.spark.yaml
LAYA_GPU_ID=0
